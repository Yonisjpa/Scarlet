<?xml version="1.0" encoding="utf-8"?>
<!-- Fuente de paquetes del proyecto: así no depende de la configuración de NuGet del equipo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
