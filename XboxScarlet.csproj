<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scarlet · app de Windows (alpha 0.4)
    Ventana a pantalla completa con WebView2 que carga la interfaz (web\index.html)
    y le da acceso a Steam, al botón Xbox, al sistema y a los mandos.
    Compilar: build.cmd  (o abrir en Visual Studio 2022 y presionar F5)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Scarlet</AssemblyName>
    <RootNamespace>XboxScarlet</RootNamespace>
    <ApplicationIcon>scarlet.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.4.19</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Scarlet</Product>
    <Company>Proyecto personal</Company>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
    <!-- Aviso inofensivo de WebView2 (trae una pieza de WPF que no usamos) -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="System.Management" Version="8.0.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="apps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="sounds\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
